{
  "name": "html-to-figma",
  "private": true,
  "type": "module",
  "description": "Universal HTML-to-Figma converter: Chrome extension (collector + conversion engine) and Figma plugin (renderer)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "schema:generate": "pnpm --filter @h2f/schema run generate",
    "schema:check": "pnpm --filter @h2f/schema run check",
    "check:universal": "node scripts/check-universal.mjs",
    "package:extension": "node scripts/package-extension.mjs",
    "preview:build": "pnpm --filter @h2f/preview build",
    "preview:open": "pnpm --filter @h2f/preview build && xdg-open packages/preview/dist/index.html",
    "verify": "pnpm schema:check && pnpm check:universal && pnpm typecheck && pnpm lint && pnpm format:check && pnpm build && pnpm package:extension && pnpm test && pnpm test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
