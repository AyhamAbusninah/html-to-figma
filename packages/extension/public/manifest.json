{
  "manifest_version": 3,
  "name": "HTML to Figma (H2F)",
  "short_name": "H2F",
  "version": "0.5.0",
  "description": "Capture the current page as editable Figma layers. Everything stays on your machine.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Capture for Figma",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "downloads", "clipboardWrite"],
  "host_permissions": [
    "*://*.arkantechjo.com/*",
    "*://localhost/*",
    "*://127.0.0.1/*",
    "*://*.localhost/*"
  ],
  "optional_host_permissions": ["<all_urls>"]
}
