{
  "manifest_version": 3,
  "name": "HTML to Figma (H2F)",
  "short_name": "H2F",
  "version": "0.1.0",
  "description": "Capture the current page as editable Figma layers. Everything stays on your machine.",
  "minimum_chrome_version": "120",
  "action": {
    "default_title": "Capture for Figma",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "downloads", "clipboardWrite", "storage"],
  "host_permissions": [
    "*://*.arkantechjo.com/*",
    "*://localhost/*",
    "*://127.0.0.1/*",
    "*://*.localhost/*"
  ],
  "optional_host_permissions": ["<all_urls>"]
}
